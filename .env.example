# Docker Compose / 本地部署使用的环境变量（复制为 .env 后修改）
# 注意：生产环境务必替换 JWT secret 与初始管理员密码

MP_PORT=8000
# 多网卡主机建议绑定内网地址，例如 192.168.113.201；0.0.0.0 表示所有网卡
MP_BIND_HOST=0.0.0.0

# 数据目录：PostgreSQL 与影像 Blob 都放在这里。5TB 级部署请指向专用磁盘。
MP_DATA_DIR=./data
# 大数据导入目录（容器内只读挂载到 /imports）
MP_IMPORT_DIR=./imports

# PostgreSQL（生产务必修改密码）
MP_DB_NAME=medpowers
MP_DB_USER=medpowers
MP_DB_PASSWORD=change-me-in-production
# 仅绑定本机，供迁移/备份脚本连接
MP_DB_PORT=5432

MEDPOWERS_JWT_SECRET=change-me-in-production-use-32-bytes-minimum
MEDPOWERS_BOOTSTRAP_ADMIN_USERNAME=admin
MEDPOWERS_BOOTSTRAP_ADMIN_PASSWORD=admin123
MEDPOWERS_PATIENT_SALT=medpowers-studio

# 生产部署：设为 production 后会拒绝默认 JWT secret
MEDPOWERS_ENVIRONMENT=development

# 设备码授权页面使用的对外地址（内网 HTTP 示例）
# 留空时按请求 Host 推导；反向代理/域名部署时务必显式设置
# MEDPOWERS_PUBLIC_BASE_URL=http://192.168.1.10:8000
MEDPOWERS_PUBLIC_BASE_URL=

# 可选 Host 白名单（JSON 数组）
MEDPOWERS_ALLOWED_HOSTS=[]

# API 访问令牌 / 设备码授权
MEDPOWERS_API_TOKEN_DEFAULT_EXPIRE_DAYS=90
MEDPOWERS_API_TOKEN_MAX_EXPIRE_DAYS=365
MEDPOWERS_DEVICE_CODE_EXPIRE_SECONDS=600
MEDPOWERS_DEVICE_POLL_INTERVAL_SECONDS=5
MEDPOWERS_AUTH_RATE_LIMIT_PER_MINUTE=20

# 仅在 HTTPS 反向代理后开启
MEDPOWERS_ENABLE_HSTS=false

# 导入前要求存储卷保留的最小空闲空间（GB）
MEDPOWERS_STORAGE_MIN_FREE_GB=50

# 可选：覆盖容器内数据库/存储路径（Compose 默认使用 PostgreSQL + /data/storage）
# MEDPOWERS_DATABASE_URL=postgresql+psycopg://medpowers:change-me@db:5432/medpowers
# MEDPOWERS_STORAGE_ROOT=/data/storage
