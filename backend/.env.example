# 数据库：本地开发默认 SQLite；生产使用 PostgreSQL（Compose 已配置）
# MEDPOWERS_DATABASE_URL=postgresql+psycopg://medpowers:change-me@db:5432/medpowers
MEDPOWERS_DATABASE_URL=sqlite:///./medpowers_studio.db

# 影像/表格/标注/导出/评估产物根目录（内容寻址 Blob 在 <root>/blobs）
MEDPOWERS_STORAGE_ROOT=./storage

# 导入前要求保留的最小空闲空间（GB）
MEDPOWERS_STORAGE_MIN_FREE_GB=50

# 默认只保留规范化格式；开启后预留原始文件保留能力（后续实现）
MEDPOWERS_KEEP_ORIGINALS=false

# 后台导入线程数（单进程）
MEDPOWERS_IMPORT_JOB_WORKERS=1

# 生产环境必须替换为至少 32 字节的随机字符串
MEDPOWERS_JWT_SECRET=dev-only-change-me-please-use-32-bytes-or-more
MEDPOWERS_ACCESS_TOKEN_EXPIRE_MINUTES=720

# development / production；production 会拒绝默认 JWT secret
MEDPOWERS_ENVIRONMENT=development

# 设备码授权链接的对外地址；留空时按请求 Host 推导
# MEDPOWERS_PUBLIC_BASE_URL=http://192.168.1.10:8000
MEDPOWERS_PUBLIC_BASE_URL=

# 可选 Host 白名单（JSON 数组）
MEDPOWERS_ALLOWED_HOSTS=[]

# 仅在 HTTPS 反向代理后开启
MEDPOWERS_ENABLE_HSTS=false

# API 访问令牌 / 设备码授权
MEDPOWERS_API_TOKEN_DEFAULT_EXPIRE_DAYS=90
MEDPOWERS_API_TOKEN_MAX_EXPIRE_DAYS=365
MEDPOWERS_DEVICE_CODE_EXPIRE_SECONDS=600
MEDPOWERS_DEVICE_POLL_INTERVAL_SECONDS=5
MEDPOWERS_AUTH_RATE_LIMIT_PER_MINUTE=20

# 首次启动自动创建的管理员
MEDPOWERS_BOOTSTRAP_ADMIN_USERNAME=admin
MEDPOWERS_BOOTSTRAP_ADMIN_PASSWORD=admin123
MEDPOWERS_BOOTSTRAP_ADMIN_DISPLAY_NAME=平台管理员

# DICOM PatientID 哈希盐；生产环境请修改
MEDPOWERS_PATIENT_SALT=medpowers-studio

# ZIP 上传大小上限（MB）
MEDPOWERS_MAX_UPLOAD_MB=4096

# CORS 允许来源（JSON 数组）
MEDPOWERS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 切片渲染时最多缓存的体数据个数
MEDPOWERS_SLICE_CACHE_VOLUMES=4
